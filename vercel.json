{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "225mb",
        "excludeFiles": "{build_model.py,merge_dataset.py,smart_scraper.py,update_reviews_db.py,dataset/**,models/*_old*,*.csv,*.ipynb}"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "api/index.py"
    }
  ]
}


